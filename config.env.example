# Copy this file to config.env on the server and fill it in.
# config.env holds secrets (GSLT, RCON password). Never commit or share it.

# Name shown in the server browser
SERVER_NAME="[EU] SURF | Timer, Ranks, WR Replays | Easy to Hard Maps"

# Short server name shown on the HUD and in chat
BRAND_NAME="SURF"

# Steam Game Server Login Token for app 4000.
# Create one at https://steamcommunity.com/dev/managegameservers
GSLT=""

# Your SteamID64 (Steam > Account details, the 17-digit number starting 7656).
# These accounts become superadmin on join. Separate several with commas.
OWNER_STEAMIDS=""

# Optional extra Steam Workshop collection to mount. Surf maps are normally
# installed by scripts/maps.py from maps/sources.txt, so leave this empty.
WORKSHOP_COLLECTION=""

# Most surf maps to install from the Workshop (each is 20-100 MB on disk)
MAX_MAPS="100"

# Discord invite and VIP store links (https://...), shown by !discord and !vip
DISCORD_URL=""
STORE_URL=""

# First map after a restart. gm_construct always exists; the gamemode then
# switches to a random surf map from the collection by itself.
START_MAP="gm_construct"

# RCON password (long and random). Leave empty to disable RCON.
RCON_PASSWORD=""

# Optional server password (leave empty for a public server)
SV_PASSWORD=""

MAXPLAYERS=24
PORT=27015
TICKRATE=100

# Two-letter country code for the server location (Facepunch rule: must be correct)
SV_LOCATION="de"
# Steam region: 0 US East, 1 US West, 2 South America, 3 Europe, 4 Asia, 5 Australia, 6 Middle East, 7 Africa
SV_REGION=3

# Linux paths (defaults match scripts/install.sh)
GMOD_USER="gmod"
GMOD_HOME="/home/gmod"
